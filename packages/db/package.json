    "db:push": "prisma db push",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@lumora/config": "workspace:*",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "typescript": "^5.8.2"
  }
}
