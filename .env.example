# ==============================================
# LUMORA ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database Connections (PostgreSQL 16)
DATABASE_URL="postgresql://lumora_user:lumora_password@localhost:5432/lumora_app?schema=public"
PII_DATABASE_URL="postgresql://lumora_user:lumora_password@localhost:5432/lumora_pii?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO / S3 Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="lumora_minio_root"
S3_SECRET_KEY="lumora_minio_password"
S3_BUCKET_RAW="uploads-raw"
S3_BUCKET_PROCESSED="media-processed"
S3_BUCKET_PUBLIC="media-public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="lumora_dev_jwt_access_secret_super_secure_minimum_32_bytes_long"
JWT_REFRESH_SECRET="lumora_dev_jwt_refresh_secret_super_secure_minimum_32_bytes_long"
SESSION_COOKIE_SECRET="lumora_dev_cookie_secret_super_secure"

# SMTP / Email (MailHog)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Lumora Support <noreply@lumora.app>"

# LiveKit (Live Streaming)
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Mock Vendor Configurations
MOCK_PAYMENT_PROVIDER="mock_ccbill"
MOCK_KYC_PROVIDER="mock_veriff"
MOCK_MODERATION_PROVIDER="mock_sightengine"
